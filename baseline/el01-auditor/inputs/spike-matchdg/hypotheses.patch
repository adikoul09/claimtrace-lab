+    def get_val_loss_total(self):
+        # AUDIT HYPOTHESIS h1b: "validation loss" read as the full training objective:
+        # cross-entropy + penalty_ws * matching penalty on matched validation pairs.
+        # The weight is the final (un-ramped) penalty_ws so that epochs are comparable.
+        # RNG state is saved and restored so training is identical to the baseline on every seed.
+        state= (random.getstate(), np.random.get_state(), torch.get_rng_state())
