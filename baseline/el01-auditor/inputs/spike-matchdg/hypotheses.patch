+                            count+= 1
+            pen= total/count
+            if not hasattr(self, 'val_pairs_logged'):
+                self.val_pairs_logged= 1
+                print(' Val matched pairs used', count, 'of', len(self.val_matched))
+        random.setstate(state[0]); np.random.set_state(state[1]); torch.set_rng_state(state[2])
+        print(' Loss: val_total', ce + self.args.penalty_ws*pen, ' penalty', pen)
+        return ce + self.args.penalty_ws*pen
+
