    "additionalProperties": false
   }
  },
  "class": {"type": "string", "enum": ["env", "compat", "hypothesis"]},
  "rationale": {"type": "string", "description": "one sentence"}
 },
 "required": ["edits", "class", "rationale"],
 "additionalProperties": false
}
